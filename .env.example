BOT_TOKEN=123456:ABC-DEF
# Secret from BotFather — same as BOT_TOKEN for initData HMAC
WEBAPP_URL=https://your-domain.com
# Comma-separated HH:MM in local timezone (3 reminders per day)
REMINDER_TIMES=09:00,15:00,21:00
TIMEZONE=Europe/Moscow
# Local (without Docker):
# DATABASE_URL=sqlite+aiosqlite:///./fitness.db
# Netrun permanent folder /data (four slashes = absolute path):
DATABASE_URL=sqlite+aiosqlite:////data/fitness.db
# Admin Telegram user IDs who can manage daily plans (comma-separated)
ADMIN_IDS=
# Private channel with exercise videos (bot must be channel admin)
CHANNEL_ID=
CHANNEL_INVITE_LINK=
